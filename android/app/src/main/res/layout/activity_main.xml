<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="@string/app_name"
            android:textColor="#C2DCAC"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/home_title"
            android:textColor="#EDF1E9"
            android:textSize="29sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/home_subtitle"
            android:textColor="#ABB8A9"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="24dp"
            android:background="#080C0A">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/camera_preview_description"
                app:implementationMode="compatible"
                app:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvPreviewHint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/camera_preview_idle"
                android:textColor="#ABB8A9"
                android:textSize="14sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1F2623"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_status"
                android:textColor="#C2DCAC"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvRecorderStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/camera_state_idle"
                android:textColor="#EDF1E9"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvStateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/camera_idle_message"
                android:textColor="#ABB8A9"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1F2623"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvCameraQualityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinnerCameraQuality"
                android:text="@string/camera_quality_title"
                android:textColor="#C2DCAC"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/camera_quality_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerCameraQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/camera_quality_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:background="#332B00"
            android:padding="12dp"
            android:textColor="#FFD54F"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#C2DCAC"
            android:minHeight="54dp"
            android:text="@string/camera_action_connect"
            android:textAllCaps="false"
            android:textColor="#233220" />

        <Button
            android:id="@+id/btnStartRecording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#C2DCAC"
            android:enabled="false"
            android:minHeight="50dp"
            android:text="@string/camera_action_start_recording"
            android:textAllCaps="false"
            android:textColor="#233220" />

        <Button
            android:id="@+id/btnStopRecording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1F2623"
            android:enabled="false"
            android:minHeight="50dp"
            android:text="@string/camera_action_stop_recording"
            android:textAllCaps="false"
            android:textColor="#EDF1E9" />

        <Button
            android:id="@+id/btnStopCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1F2623"
            android:enabled="false"
            android:minHeight="50dp"
            android:text="@string/camera_action_stop_camera"
            android:textAllCaps="false"
            android:textColor="#EDF1E9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#1F2623"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/viewer_section_title"
                android:textColor="#C2DCAC"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvViewerStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/viewer_stopped"
                android:textColor="#EDF1E9"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvViewerNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/viewer_phase_notice"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvViewerEndpoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/viewer_no_endpoint"
                android:textColor="#EDF1E9"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvViewerFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/viewer_no_fingerprint"
                android:textColor="#ABB8A9"
                android:textIsSelectable="true"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnStartViewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#C2DCAC"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/viewer_action_start"
                android:textAllCaps="false"
                android:textColor="#233220" />

            <Button
                android:id="@+id/btnStopViewer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#101613"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/viewer_action_stop"
                android:textAllCaps="false"
                android:textColor="#EDF1E9" />

            <Button
                android:id="@+id/btnViewerPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#C2DCAC"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/viewer_password_title"
                android:textAllCaps="false"
                android:textColor="#233220" />

            <TextView
                android:id="@+id/tvViewerPasswordStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/viewer_password_unset"
                android:textColor="#AAB6AE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPairingCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#101613"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/viewer_action_code"
                android:textAllCaps="false"
                android:textColor="#EDF1E9" />

            <Button
                android:id="@+id/btnPendingViewers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:backgroundTint="#101613"
                android:enabled="false"
                android:minHeight="48dp"
                android:text="@string/viewer_action_requests"
                android:textAllCaps="false"
                android:textColor="#EDF1E9" />
        </LinearLayout>

        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1F2623"
            android:minHeight="50dp"
            android:text="@string/action_history"
            android:textAllCaps="false"
            android:textColor="#EDF1E9" />

        <Button
            android:id="@+id/btnRetention"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1F2623"
            android:minHeight="50dp"
            android:text="@string/action_retention"
            android:textAllCaps="false"
            android:textColor="#EDF1E9" />

        <Button
            android:id="@+id/btnMotionEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#1F2623"
            android:minHeight="50dp"
            android:text="@string/action_motion_events"
            android:textAllCaps="false"
            android:textColor="#EDF1E9" />

        <LinearLayout
            android:id="@+id/cardStoragePolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1F2623"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvStoragePolicyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/spinnerStorageMode"
                android:text="@string/storage_policy_title"
                android:textColor="#C2DCAC"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStoragePolicyHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_policy_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerStorageMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/storage_policy_mode_label" />

            <TextView
                android:id="@+id/tvStorageMotionWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#332B00"
                android:padding="10dp"
                android:text="@string/storage_policy_motion_warning"
                android:textColor="#FFD54F"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvFpsModeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/spinnerFpsMode"
                android:text="@string/storage_fps_mode_label"
                android:textColor="#C2DCAC"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerFpsMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/storage_fps_mode_label" />

            <TextView
                android:id="@+id/tvFpsModeHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_fps_mode_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCodecTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:labelFor="@id/spinnerCodec"
                android:text="@string/storage_codec_label"
                android:textColor="#C2DCAC"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spinnerCodec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/storage_codec_label" />

            <TextView
                android:id="@+id/tvCodecHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_codec_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbEncoderTuning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/storage_encoder_tuning_label"
                android:textColor="#EDF1E9" />

            <TextView
                android:id="@+id/tvEncoderTuningHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/storage_encoder_tuning_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/storage_audio_label"
                android:textColor="#EDF1E9" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_audio_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbSpeaker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/storage_speaker_label"
                android:textColor="#EDF1E9" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/storage_speaker_help"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etStorageMaxDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/storage_policy_max_days"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="48dp"
                android:textColor="#EDF1E9"
                android:textColorHint="#8A968C" />

            <EditText
                android:id="@+id/etStorageMaxGb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/storage_policy_max_gb"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="#EDF1E9"
                android:textColorHint="#8A968C" />

            <TextView
                android:id="@+id/tvStoragePolicyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="#ABB8A9"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStorageSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#C2DCAC"
                android:minHeight="48dp"
                android:text="@string/storage_policy_save"
                android:textAllCaps="false"
                android:textColor="#233220" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/camera_capture_notice"
            android:textColor="#ABB8A9"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
