<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/viewer_bg">

    <!-- Top Action & Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/viewer_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/viewStatusDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_status_dot" />

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/status_connecting"
            android:textColor="@color/viewer_text_secondary"
            android:textSize="12sp" />

        <!-- Current Server Address Badge: co lại theo chỗ trống để 4 nút bên phải luôn hiện trên màn hình hẹp -->
        <TextView
            android:id="@+id/tvServerBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:gravity="end"
            android:maxLines="1"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="monospace"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="@color/viewer_text_secondary"
            android:textSize="12sp"
            tools:text="192.168.0.106:8443" />

        <!-- Change Server Button -->
        <ImageButton
            android:id="@+id/btnEditServer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:padding="8dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/viewer_text_secondary" />

        <!-- Check for app update -->
        <ImageButton
            android:id="@+id/btnUpdate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_update"
            android:padding="8dp"
            android:src="@drawable/ic_update"
            app:tint="@color/viewer_text_secondary" />

        <!-- Reload Button -->
        <ImageButton
            android:id="@+id/btnReload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_reload"
            android:padding="8dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/viewer_text_secondary" />

        <!-- Fullscreen Button -->
        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_fullscreen"
            android:padding="8dp"
            android:src="@drawable/ic_fullscreen"
            app:tint="@color/viewer_text_secondary" />
    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:indeterminateOnly="false"
        android:max="100"
        android:progressDrawable="@color/viewer_accent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Main Content Frame (WebView + Overlays) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar">

        <!-- Embedded WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/viewer_bg" />

        <!-- Offline / Connection Error Overlay -->
        <ScrollView
            android:id="@+id/layoutErrorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/viewer_bg"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_title"
                        android:textColor="@color/viewer_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/error_desc"
                        android:textColor="@color/viewer_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/server_dialog_title"
                        android:textColor="@color/viewer_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etServerUrl"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:hint="@string/server_dialog_hint"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/viewer_text_primary"
                        android:textColorHint="@color/viewer_border"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnResetDefault"
                            style="?android:attr/borderlessButtonStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_button_secondary"
                            android:text="@string/btn_reset_default"
                            android:textColor="@color/viewer_text_secondary"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnRetry"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_button_primary"
                            android:paddingHorizontal="20dp"
                            android:text="@string/btn_retry"
                            android:textColor="@color/viewer_bg"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Floating Button to restore topbar when in Fullscreen -->
        <ImageButton
            android:id="@+id/btnFloatingExitFullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_floating_button"
            android:contentDescription="@string/action_exit_fullscreen"
            android:padding="10dp"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone"
            app:tint="@color/viewer_text_primary" />
    </FrameLayout>

    <!-- Fullscreen Container for HTML5 Video / Media -->
    <FrameLayout
        android:id="@+id/fullscreenContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
